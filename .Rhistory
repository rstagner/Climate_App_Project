ui <- fluidPage(
titlePanel("U.S. Climate & Environmental Analytics Dashboard"),
sidebarLayout(
sidebarPanel(
width = 3,
h4("Dashboard Controls"),
# City selection (populated dynamically from successfully pulled cities)
selectInput(
inputId = "selected_city",
label = "Select City:",
choices = sort(unique(all_cities_nasa$city)),
selected = "New York"
),
# Date range input
dateRangeInput(
inputId = "date_range",
label = "Select Date Range:",
start = "2020-01-01",
end = Sys.Date(),
min = "1990-01-01",
max = Sys.Date()
),
# Climate metric selection
selectInput(
inputId = "climate_metric",
label = "Select Climate Metric (NASA POWER):",
choices = c(
"Mean Temperature (°C)" = "T2M",
"Max Temperature (°C)" = "T2M_MAX",
"Min Temperature (°C)" = "T2M_MIN",
"Precipitation (mm/day)" = "PRECTOTCORR",
"Specific Humidity (g/kg)" = "QV2M"
),
selected = "T2M"
),
hr(),
helpText("Data Sources: NASA POWER API, NOAA GHCN-Daily, & U.S. Census Gazetteer.")
),
mainPanel(
width = 9,
tabsetPanel(
id = "main_tabs",
# Tab 1: Exploratory Data Analysis (Vignette Element 5)
tabPanel(
title = "Exploratory Data Analysis",
br(),
fluidRow(
column(12,
h3("Time Series Climate Trends"),
p("Examine daily meteorological trends and smooth LOESS curves over time for the selected U.S. city."),
plotOutput("time_series_plot", height = "400px")
)
),
hr(),
fluidRow(
column(6,
h4("Summary Statistics"),
verbatimTextOutput("summary_stats")
),
column(6,
h4("Nearest NOAA Station Metadata"),
tableOutput("station_meta_table")
)
)
),
# Tab 2: Statistical Analysis (Vignette Element 6)
tabPanel(
title = "Statistical Analysis",
br(),
h3("Linear Trend & Ordinary Least Squares (OLS) Modeling"),
p("Evaluate long-term climate trajectories by fitting an OLS regression model across the selected timeframe."),
plotOutput("regression_plot", height = "400px"),
br(),
h4("Regression Model Summary Output"),
verbatimTextOutput("model_summary")
),
# Map Tab
tabPanel(
title = "U.S. Climate Map",
br(),
h3("Spatial Distribution of Temperature Trends Across U.S. Cities"),
p("Explore geographical patterns of temperature change. Circle colors represent the magnitude of warming or cooling."),
leafletOutput("climate_map", height = "550px")
),
# Tab 3: Data Explorer
tabPanel(
title = "Data Explorer",
br(),
h3("Filtered Dataset View"),
p("Inspect the underlying records currently filtered by the user controls."),
DTOutput("raw_data_table")
)
)
)
)
)
# ==============================================================================
# SERVER LOGIC
# ==============================================================================
server <- function(input, output, session) {
# Reactive filtered dataset based on city and date range
filtered_data <- reactive({
req(input$selected_city, input$date_range)
all_cities_nasa |>
filter(
city == input$selected_city,
date >= input$date_range[1],
date <= input$date_range[2]
)
})
# Reactive station metadata for the selected city
selected_station <- reactive({
req(input$selected_city)
matched_stations |>
filter(city == input$selected_city)
})
# Tab 1: Time Series Plot
output$time_series_plot <- renderPlot({
df <- filtered_data()
req(nrow(df) > 0)
metric_label <- case_when(
input$climate_metric == "T2M" ~ "Mean Temperature (°C)",
input$climate_metric == "T2M_MAX" ~ "Max Temperature (°C)",
input$climate_metric == "T2M_MIN" ~ "Min Temperature (°C)",
input$climate_metric == "PRECTOTCORR" ~ "Precipitation (mm/day)",
input$climate_metric == "QV2M" ~ "Specific Humidity (g/kg)",
TRUE ~ input$climate_metric
)
ggplot(df, aes(x = date, y = .data[[input$climate_metric]])) +
geom_line(color = "#2c3e50", alpha = 0.7, linewidth = 0.5) +
geom_smooth(method = "loess", color = "#e74c3c", se = TRUE, span = 0.2) +
theme_minimal(base_size = 14) +
labs(
title = paste("Climate Trend for", input$selected_city),
subtitle = paste("Metric:", metric_label),
x = "Date",
y = metric_label
) +
theme(
plot.title = element_text(face = "bold", size = 16),
panel.grid.minor = element_blank()
)
})
# Tab 1: Summary Statistics
output$summary_stats <- renderPrint({
df <- filtered_data()
req(nrow(df) > 0)
summary(df[[input$climate_metric]])
})
# Tab 1: Station Metadata Table
output$station_meta_table <- renderTable({
st <- selected_station()
req(nrow(st) > 0)
st |>
mutate(distance_km = round(distance_km, 2)) |>
rename(
City = city,
State = state,
Lat = lat,
Lon = lon,
"NOAA ID" = station_id,
"Station Name" = station_name,
"Distance (km)" = distance_km
)
})
# Tab 2: Regression Plot
output$regression_plot <- renderPlot({
df <- filtered_data()
req(nrow(df) > 0)
ggplot(df, aes(x = date, y = .data[[input$climate_metric]])) +
geom_point(alpha = 0.3, color = "#7f8c8d", size = 1) +
geom_smooth(method = "lm", color = "#2980b9", se = TRUE, linewidth = 1) +
theme_minimal(base_size = 14) +
labs(
title = paste("Linear Trend Analysis:", input$selected_city),
subtitle = "Ordinary Least Squares (OLS) Fit over Selected Date Range",
x = "Date",
y = input$climate_metric
) +
theme(
plot.title = element_text(face = "bold", size = 16),
panel.grid.minor = element_blank()
)
})
# Tab 2: Model Summary
output$model_summary <- renderPrint({
df <- filtered_data()
req(nrow(df) > 0)
formula_obj <- reformulate("date", response = input$climate_metric)
model <- lm(formula_obj, data = df)
summary(model)
})
# Map Output (Correctly nested inside the server function with proper join order)
# Map Output (Swapped to OpenStreetMap tiles to eliminate the API key error)
output$climate_map <- renderLeaflet({
metric <- input$climate_metric
map_data <- all_cities_nasa |>
inner_join(top_50_cities, by = "city") |>
group_by(city, state, lat, lon) |>
summarize(
temp_change = {
fit <- lm(.data[[metric]] ~ as.numeric(date))
coef(fit)[2] * 365.25 * 10 # Net change per decade (°C/decade)
},
.groups = "drop"
) |>
drop_na(lat, lon, temp_change)
pal <- colorNumeric(
palette = "RdBu",
domain = map_data$temp_change,
reverse = TRUE # Blue for cooling, Red for warming
)
leaflet(map_data) |>
addProviderTiles(providers$OpenStreetMap.Mapnik) |> # <--- Zero API key required
setView(lng = -98.5795, lat = 39.8283, zoom = 4) |>
addCircleMarkers(
lng = ~lon,
lat = ~lat,
radius = 8,
color = ~pal(temp_change),
stroke = TRUE,
weight = 1,
fillOpacity = 0.8,
popup = ~paste0(
"<strong>City: </strong>", city, ", ", state, "<br>",
"<strong>Metric: </strong>", metric, "<br>",
"<strong>Trend: </strong>", round(temp_change, 3), " °C / decade"
)
) |>
addLegend(
position = "bottomright",
pal = pal,
values = ~temp_change,
title = "Temp Change<br>(°C / Decade)",
opacity = 1
)
})
shinyApp(ui = ui, server = server)
